# Copy to .env. Keep comments on their own line and values unquoted:

# required
GITHUB_TOKEN=
# optional, defaults to the repo's default branch
DEFAULT_BRANCH=
# optional, defaults to the whole repo
DOCS_FOLDER_PATH=
# optional
MAX_FILE_TOKENS=100000

# required: MCP_TOKEN_SHA256 (sha256 of the client token) is appended by the token command in the README
